# FS-Corporation fs-dev production environment
# Copy to /etc/fs-corporation/env (chmod 600, chown root:fs-corp) and adjust values.

FS_CORP_INSTALL_DIR=/opt/fs-corporation
FS_CORP_DATA_DIR=/var/lib/fs-corporation
FS_CORP_DB=/var/lib/fs-corporation/company.db
FS_CORP_TOKEN_FILE=/etc/fs-corporation/owner.token
FS_CORP_API_HOST=127.0.0.1
FS_CORP_API_PORT=8000
FS_CORP_COMPANION_DIST=/var/lib/fs-corporation/companion/dist

# Edge proxy (Caddy) — primary LAN address
FS_CORP_LAN_IP=192.168.4.100

# Reserved for phase-2 worker / HA NIC (Docker workers, internal traffic)
FS_CORP_WORKER_NIC_IP=192.168.4.101

# Optional: set after `tailscale ip -4` and uncomment matching block in Caddyfile
# FS_CORP_TAILSCALE_IP=100.x.x.x

# Pairing QR public origin (LAN or Tailscale HTTPS). Used for companion pair_url.
FS_CORP_PUBLIC_URL=https://192.168.4.100

# Optional reusable Tailscale auth key — returned only on pairing redeem, never in QR.
# FS_CORP_TAILSCALE_AUTHKEY=tskey-auth-...

# Dev only: allow companion preview on http://127.0.0.1:4173 to call loopback API
# FS_CORP_ALLOW_CORS=1
