# Optional live-integration secrets for fs-dev
# Copy to /etc/fs-corporation/secrets.env (chmod 600, chown root:fs-corp)
# Source from systemd or merge into /etc/fs-corporation/env — never commit real values.

# --- GitHub App (pilot repo only) ---
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_FILE=/etc/fs-corporation/github-app.pem
GITHUB_WEBHOOK_SECRET=

# --- Model provider (worker/gateway boundary only) ---
MODEL_PROVIDER_API_KEY=
# IMAGE_PROVIDER_API_KEY=
ANTHROPIC_API_KEY=

# --- Market feed (if vendor requires auth) ---
# FEED_API_KEY=

# --- Web Push (optional) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=mailto:owner@example.com

# --- Tailscale pairing handoff (host only; never in QR) ---
# FS_CORP_TAILSCALE_AUTHKEY=tskey-auth-...
