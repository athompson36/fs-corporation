# FS-Corporation edge proxy for fs-dev (Debian + Caddy 2)
#
# Install:
#   sudo apt install caddy
#   sudo cp deploy/fs-dev/Caddyfile /etc/caddy/Caddyfile
#   # Set FS_CORP_LAN_IP and optional tailnet IP below, then:
#   sudo systemctl restart caddy
#
# Use restart, not reload: `admin off` disables the admin API that
# `caddy reload` posts the new config to, so reload can never succeed.
#
# API stays on 127.0.0.1:8000; only Caddy listens on LAN/Tailscale HTTPS.

{
	admin off
	# The caddy service user cannot sudo, so trusting the local CA fails and
	# aborts config load. Browsers get a self-signed warning for the IP site.
	skip_install_trust

	servers {
		# No HTTP/3: wg0 already holds UDP 443 on fs-dev, and the QUIC
		# listener failing to bind aborts the whole config load.
		protocols h1 h2
	}
}

(lan_site) {
	root * /var/lib/fs-corporation/companion/dist
	encode gzip

	# Server-Sent Events — disable buffering
	handle /api/v1/events/stream {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			header_up Connection "keep-alive"
			header_up Cache-Control "no-cache"
		}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# SPA static assets + client-side routes (non-API)
	handle /* {
		try_files {path} /index.html
		file_server
	}
}

https://192.168.4.100 {
	import lan_site
}

# Uncomment and set your tailnet IP after `tailscale ip -4`:
# https://100.x.x.x {
# 	import lan_site
# }
