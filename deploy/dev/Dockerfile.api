# Local development control API
# Build: docker build -f deploy/dev/Dockerfile.api -t fs-corporation-api:dev .
FROM python:3.12-slim

WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md alembic.ini /src/
COPY company /src/company
COPY alembic /src/alembic
COPY scripts /src/scripts

RUN pip install --no-cache-dir /src

COPY deploy/dev/docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV FS_CORP_DATA_DIR=/data
VOLUME /data
EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["--host", "0.0.0.0", "--port", "8000", "--allow-remote", "--data-dir", "/data", "--db", "/data/company.db", "--token-file", "/data/owner.token"]
