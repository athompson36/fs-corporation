# Reserved for future live workers; the offline core does not load this file.
COMPANY_MODE=offline_mock
COMPANY_PAUSED=true
CHATDEV_CHECKOUT=./upstream/ChatDev
# Never commit real keys or expose them in prompts, logs, or browser code.
# Full checklist: docs/26-owner-live-configuration.md
# Status: python3 scripts/check_owner_config.py
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=

# --- Model (worker/gateway only) ---
MODEL_PROVIDER_API_KEY=
# MODEL_PROVIDER_BASE_URL=https://api.openai.com/v1
# MODEL_PROVIDER_MAX_TOKENS=512
ANTHROPIC_API_KEY=
# ANTHROPIC_STATUS_MODEL=claude-3-5-haiku-latest
# IMAGE_PROVIDER_API_KEY=

# --- Feed (optional auth) ---
# FEED_API_KEY=

# --- Web Push (optional) ---
# Web Push (VAPID) — generate with: python scripts/generate_vapid_keys.py
# VAPID_PUBLIC_KEY_FILE=/run/secrets/vapid-public.pem
# VAPID_PRIVATE_KEY_FILE=/run/secrets/vapid-private.pem
# VAPID_CONTACT_EMAIL=mailto:owner@example.com

# --- Host / pairing (never put owner token here) ---
# FS_CORP_WORKER_SCRATCH_HOST=/absolute/path/to/repo/.local/worker-scratch
# FS_CORP_PUBLIC_URL=https://192.168.4.100
# FS_CORP_LAN_IP=192.168.4.100
# FS_CORP_TAILSCALE_AUTHKEY=tskey-auth-...
# FS_CORP_ALLOW_CORS=1
